@verytall_narrow = [Iacute Icaron Icircumflex Idieresis Idotaccent Igrave Ihookabove Imacron lacute];
@verytall_7wide = [AEacute Ohornacute Ohorngrave Ohornhookabove Ohorntilde Uhornacute Uhorngrave Uhornhookabove Uhorntilde];
@verylong = [Abrevedotbelow Acircumflexdotbelow Ecircumflexdotbelow Ldotbelowmacron Ocircumflexdotbelow Oogonekmacron Rdotbelowmacron];
@verylong_narrow = [ldotbelowmacron];
