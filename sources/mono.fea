
# mark classes
markClass [gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb hookabovecomb ringcomb hungarumlautcomb caroncomb verticallineabovecomb commaturnedabovecomb commaabovecomb circumflexcomb_acutecomb circumflexcomb_gravecomb circumflexcomb_hookabovecomb circumflexcomb_tildecomb] <anchor 300 600> @marks_above;
markClass [dotbelowcomb uni0324 commaaccentcomb cedillacomb uni0329 brevebelowcomb macronbelowcomb    uni0332 uni0335] <anchor 300 0> @marks_below; # includes comb short stroke overlay (uni0335)
markClass [ogonekcomb] <anchor 300 0> @marks_belowright;
markClass [uni0315 horncomb dotaboverightcomb] <anchor 300 500> @marks_aboveright;
# markClass [gravecomb acutecomb circumflexcomb tildecomb brevecomb ringcomb hungarumlautcomb caroncomb commaturnedabovecomb] <anchor 0 600> @tall_marks_above;
# markClass [macroncomb dotaccentcomb dieresiscomb] <anchor 0 600> @short_marks_above;
# markClass [gravecomb acutecomb dotaccentcomb ringcomb caroncomb commaturnedabovecomb] <anchor 0 600> @narrow_marks_above;
# markClass [circumflexcomb tildecomb macroncomb brevecomb dieresiscomb hungarumlautcomb] <anchor 0 600> @wide_marks_above;

feature mark {
	pos @marks_above <-300 0 -600 0>;
	pos @marks_below <-300 0 -600 0>;
	pos @marks_belowright <-300 0 -600 0>;
	pos @marks_aboveright <-300 0 -600 0>;
	pos base @tall
		<anchor 300 800> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @tall_ogonek
		<anchor 300 800> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 400 0> mark @marks_belowright;
	pos base @tall_narrow
		<anchor 300 800> mark @marks_above
		<anchor 450 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @tall_1wide
		<anchor 300 800> mark @marks_above
		<anchor 350 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @tall_4wide
		<anchor 300 800> mark @marks_above
		<anchor 450 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @tall_6wide
		<anchor 300 800> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 400 0> mark @marks_belowright;
	pos base @tall_6wide2
		<anchor 300 800> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 400 0> mark @marks_belowright;
	pos base @tall_7wide
		<anchor 300 800> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 400 0> mark @marks_belowright;
	pos base @verytall
		<anchor 300 1000> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @verytall_narrow
		<anchor 300 1000> mark @marks_above
		<anchor 450 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @verytall_7wide
		<anchor 400 1000> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 400 0> mark @marks_belowright;
	pos base @long
		<anchor 300 800> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 -200> mark @marks_below
		<anchor 400 -200> mark @marks_belowright;
	pos base @long_narrow
		<anchor 300 800> mark @marks_above
		<anchor 450 500> mark @marks_aboveright
		<anchor 300 -200> mark @marks_below
		<anchor 300 -200> mark @marks_belowright;
	pos base @long_7wide
		<anchor 300 800> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 400 -200> mark @marks_below
		<anchor 500 -200> mark @marks_belowright;
	pos base @verylong
		<anchor 300 1000> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 -200> mark @marks_below
		<anchor 400 -200> mark @marks_belowright;
	pos base @verylong_narrow
		<anchor 300 1000> mark @marks_above
		<anchor 450 500> mark @marks_aboveright
		<anchor 300 -200> mark @marks_below
		<anchor 300 -200> mark @marks_belowright;
	pos base @J
		<anchor 400 800> mark @marks_above
		<anchor 550 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @Jsc
		<anchor 400 600> mark @marks_above
		<anchor 550 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @L
		<anchor 100 800> mark @marks_above
		<anchor 150 500> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @Lsc
		<anchor 300 600> mark @marks_above
		<anchor 150 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @short
		<anchor 300 600> mark @marks_above
		<anchor 550 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @short_narrow
		<anchor 300 600> mark @marks_above
		<anchor 450 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @short_ogonek
		<anchor 300 600> mark @marks_above
		<anchor 550 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 400 0> mark @marks_belowright;
	pos base @short_4wide
		<anchor 300 600> mark @marks_above
		<anchor 450 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @short_6wide
		<anchor 300 600> mark @marks_above
		<anchor 550 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @short_6wide2
		<anchor 300 600> mark @marks_above
		<anchor 550 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
	pos base @short_7wide
		<anchor 400 600> mark @marks_above
		<anchor 550 300> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 400 0> mark @marks_belowright;
	pos base @deep
		<anchor 300 600> mark @marks_above
		<anchor 550 300> mark @marks_aboveright
		<anchor 300 -200> mark @marks_below
		<anchor 300 -200> mark @marks_belowright;
	pos base @deep_narrow
		<anchor 300 600> mark @marks_above
		<anchor 450 300> mark @marks_aboveright
		<anchor 300 -200> mark @marks_below
		<anchor 300 -200> mark @marks_belowright;
	pos base @deep_7wide
		<anchor 400 600> mark @marks_above
		<anchor 550 300> mark @marks_aboveright
		<anchor 400 -200> mark @marks_below
		<anchor 400 -200> mark @marks_belowright;
	pos base @j_mark
		<anchor 400 800> mark @marks_above
		<anchor 450 500> mark @marks_aboveright
		<anchor 300 -200> mark @marks_below
		<anchor 300 -200> mark @marks_belowright;
	pos base @j_mark2
		<anchor 400 600> mark @marks_above
		<anchor 450 500> mark @marks_aboveright
		<anchor 300 -200> mark @marks_below
		<anchor 300 -200> mark @marks_belowright;
	pos base @t_mark
		<anchor 300 800> mark @marks_above
		<anchor 350 600> mark @marks_aboveright
		<anchor 300 0> mark @marks_below
		<anchor 300 0> mark @marks_belowright;
} mark;

feature mkmk {
	pos mark @marks_above
		<anchor 300 800> mark @marks_above;
	pos mark @marks_below
		<anchor 300 -200> mark @marks_below;
} mkmk;

feature frac {
	sub one [slash fraction] four by onequarter;
	sub one [slash fraction] two by onehalf;
	sub three [slash fraction] four by threequarters;
	sub one [slash fraction] three by onethird;
	sub two [slash fraction] three by twothirds;
	sub one [slash fraction] eight by oneeighth;
	sub three [slash fraction] eight by threeeighths;
	sub five [slash fraction] eight by fiveeighths;
	sub seven [slash fraction] eight by seveneighths;
} frac;
