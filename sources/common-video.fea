@c2sc_dsrt = [u10428 u10429 u1042A u1042B u1042C u1042D u1042E u1042F u10430 u10431 u10432 u10433 u10434 u10435 u10436 u10437 u10438 u10439 u1043A u1043B u1043C u1043D u1043E u1043F u10440 u10441 u10442 u10443 u10444 u10445 u10446 u10447 u10448 u10449 u1044A u1044B u1044C u1044D u1044E u1044F];

feature c2sc {
	script latn;
	sub @uc by @c2sc;
	language CAT;
	language TAT;
	language TRK;
	language KAZ;
	language AZE;
	language CRT;
	language MOL;
	language ROM;
	language NSM;
	language NLD;

	script cyrl;
	sub @uc_cy by @c2sc_cy;
	language SRB;
	language BGR;

	script grek;
	sub @uc_gr by @c2sc_gr;

	script armn;
	sub @uc_ar by @c2sc_ar;
	
	script dsrt;
	sub @uc_dsrt by @c2sc_dsrt;
} c2sc;

feature smcp {
	script latn;
	sub @lc by @smcp;
	language CAT;
	language TAT;
	language TRK;
	language KAZ;
	language AZE;
	language CRT;
	language MOL;
	language ROM;
	language NSM;
	language NLD;

	script cyrl;
	sub @lc_cy by @smcp_cy;
	language SRB;
	language BGR;

	script grek;
	sub @lc_gr by @smcp_gr;

	script armn;
	sub @lc_ar by @sc_ar;
} smcp;

@_marks_above = [gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb hookabovecomb ringcomb hungarumlautcomb caroncomb verticallineabovecomb commaturnedabovecomb commaabovecomb circumflexcomb_acutecomb circumflexcomb_gravecomb circumflexcomb_hookabovecomb circumflexcomb_tildecomb];
@_marks_below = [dotbelowcomb uni0324 commaaccentcomb cedillacomb uni0329 brevebelowcomb macronbelowcomb    uni0332 uni0335]; # includes comb short stroke overlay (uni0335)

feature ccmp {
	script cyrl;
	sub i-cy' @_marks_above by dotlessi;
	sub Yi-cy' @_marks_above by idieresis.sc;
	sub je-cy' @_marks_above by jdotless;
	language SRB;
	language BGR;

	script grek;
	sub Alpha acutecomb by Alphatonos;
	sub Epsilon acutecomb by Epsilontonos;
	sub Eta acutecomb by Etatonos;
	sub Iota acutecomb by Iotatonos;
	sub Omicron acutecomb by Omicrontonos;
	sub Upsilon acutecomb by Upsilontonos;
	sub Omega acutecomb by Omegatonos;
	sub uni03D2 acutecomb by uni03D3;
	sub upsilon dieresiscomb acutecomb by upsilondieresistonos;
	sub iota dieresiscomb acutecomb by iotadieresistonos;
	sub [alpha epsilon eta iota omicron upsilon omega] acutecomb' by verticallineabovecomb;

	script latn;
	sub y' @_marks_below by y.titl;
	# soft dotted characters
	sub [i j ibar]' @_marks_above by [dotlessi jdotless ibardotless];
	sub idotbelow' @_marks_above by dotlessi dotbelowcomb;
	sub iogonek' @_marks_above by dotlessi ogonekcomb;
	# czech/slovak hacek
	sub L caroncomb' by uni0315;
	sub d caroncomb by dcaron;
	sub l caroncomb by lcaron;
	sub t caroncomb' by uni0315;
	sub l.sc caroncomb' by uni0315;
	# fix combining comma below
	sub G cedillacomb' by commaaccentcomb;
	sub g cedillacomb' by commaturnedabovecomb;
	sub K cedillacomb' by commaaccentcomb;
	sub k cedillacomb' by commaaccentcomb;
	sub L cedillacomb' by commaaccentcomb;
	sub l cedillacomb' by commaaccentcomb;
	sub N cedillacomb' by commaaccentcomb;
	sub n cedillacomb' by commaaccentcomb;
	sub R cedillacomb' by commaaccentcomb;
	sub r cedillacomb' by commaaccentcomb;
	sub g.sc cedillacomb' by commaaccentcomb;
	sub kgreenlandic cedillacomb' by commaaccentcomb;
	sub l.sc cedillacomb' by commaaccentcomb;
	sub n.sc cedillacomb' by commaaccentcomb;
	sub r.sc cedillacomb' by commaaccentcomb;
	# improve look of video, smooth styles
	sub A ogonekcomb by Aogonek;
	sub u ogonekcomb by uogonek;
	sub a.sc ogonekcomb by aogonek.sc;
	# vietnamese diacritics
	sub circumflexcomb acutecomb by circumflexcomb_acutecomb;
	sub circumflexcomb gravecomb by circumflexcomb_gravecomb;
	sub circumflexcomb hookabovecomb by circumflexcomb_hookabovecomb;
	sub circumflexcomb tildecomb by circumflexcomb_tildecomb;
	sub O horncomb by Ohorn;
	sub o horncomb by ohorn;
	sub U horncomb by Uhorn;
	sub u horncomb by uhorn;
	sub u.sc horncomb by uhorn.sc;
	language CAT;
	language NSM;
	language NLD;
sub D by D.alt;sub Eth by Eth.alt;sub Dcroat by Dcroat.alt;sub Dhook by Dhook.alt;sub Dcaron by Dcaron.alt;sub Ddotbelow by Ddotbelow.alt;sub Dmacronbelow by Dmacronbelow.alt;} ccmp;

feature locl {
	script latn;
	language CAT;
		sub l' periodcentered' l by ldot;
		sub l.sc' periodcentered' l.sc by ldot;
		sub L' periodcentered' L by Ldot;
	language TAT;
		sub i by idotaccent;
	language TRK;
		sub i by idotaccent;
	language KAZ;
		sub i by idotaccent;
	language AZE;
		sub i by idotaccent;
	language CRT;
		sub i by idotaccent;
	language MOL;
		sub Scedilla by Scommaaccent;
		sub scedilla by scommaaccent;
		sub Tcedilla by Tcommaaccent;
		sub tcedilla by tcommaaccent;
	language ROM;
		sub Scedilla by Scommaaccent;
		sub scedilla by scommaaccent;
		sub Tcedilla by Tcommaaccent;
		sub tcedilla by tcommaaccent;
	language NSM;
		lookup locl_NSM {
			sub Eng by Eng.loclNSM;
			sub eng.sc by eng.sc.loclNSM;
		} locl_NSM;		
	language NLD;
		sub iacute j by iacute_jacute;
		sub i acutecomb j by iacute_jacute;
		sub i j acutecomb by iacute_jacute;
		sub ij acutecomb by iacute_jacute;
		sub Iacute J by Iacute_Jacute;
		sub I acutecomb J by Iacute_Jacute;
		sub I acutecomb j by Iacute_Jacute;
		sub I acutecomb j.sc by Iacute_Jacute;
		sub I J acutecomb by Iacute_Jacute;
		sub I j acutecomb by Iacute_Jacute;
		sub I j.sc acutecomb by Iacute_Jacute;
		sub IJ acutecomb by Iacute_Jacute;
		sub i j by ij;
		sub i.sc j.sc by ij.sc;
		sub I [J j j.sc] by IJ;
	script cyrl;
		sub three by three.alt;
	language SRB;
		lookup locl_SRB {
			sub be-cy by be-cy.loclSRB;
		} locl_SRB;
	language BGR;
		lookup locl_BGR {
			sub [ve-cy ge-cy de-cy zhe-cy ze-cy ii-cy iishort-cy ka-cy el-cy pe-cy te-cy tse-cy sha-cy shcha-cy yu-cy] by [ve-cy.loclBGR ge-cy.loclBGR g zhe-cy.loclBGR ze-cy.loclBGR u ubreve k el-cy.loclBGR n m tse-cy.loclBGR sha-cy.loclBGR shcha-cy.loclBGR yu-cy.loclBGR];
		} locl_BGR;
} locl;

feature zero {
	sub zero by O;
	sub zero.sc by o;
} zero;

@figures = [zero one two three four five six seven eight nine];
@figures_sc = [zero.sc one.sc two.sc three.sc four.sc five.sc six.sc seven.sc eight.sc nine.sc];
@numr = [uni2070 onesuperior twosuperior threesuperior foursuperior fivesuperior sixsuperior sevensuperior eightsuperior ninesuperior];
@dnom = [uni2080 oneinferior twoinferior threeinferior fourinferior fiveinferior sixinferior seveninferior eightinferior nineinferior];

lookup NUMR {
	sub @figures by @numr;
	sub @figures_sc by @numr;
} NUMR;

lookup DNOM {
	sub @figures by @dnom;
	sub @figures_sc by @dnom;
} DNOM;

feature numr {
	lookup NUMR;
} numr;

feature dnom {
	lookup DNOM;
} dnom;

feature sups {
	lookup NUMR;
} sups;

feature subs {
	lookup DNOM;
} subs;

feature ss01 {
	featureNames {
		name "Alternate capital letter D, etc.";
	};
	# these get added to the end of ccmp automatically for Video style
	sub D.alt by D;
	sub Eth.alt by Eth;
	sub Dcroat.alt by Dcroat;
	sub Dhook.alt by Dhook;
	sub Dcaron.alt by Dcaron;
	sub Ddotbelow.alt by Ddotbelow;
	sub Dmacronbelow.alt by Dmacronbelow;
} ss01;

feature ss02 {
	featureNames {
		name "Alternate numerals 2, 6 and 9";
	};
	sub two by two.alt;
	sub six by six.alt;
	sub nine by nine.alt;
} ss02;

feature ss03 {
	featureNames {
		name "Alternate numeral 3";
	};
	sub three by three.alt;
} ss03;

feature ss04 {
	featureNames {
		name "Alternate numeral 4";
	};
	sub four by four.alt;
} ss04;

feature ss05 {
	featureNames {
		name "Alternate small Greek letter φ (phi)";
	};
	sub phi by phi1;
	sub phi1 by phi;
} ss05;

feature ss06 {
	featureNames {
		name "Alternate capital letter Ŋ (Eng)";
	};
	lookup locl_NSM;
} ss06;

feature ss07 {
	featureNames {
		name "Serbian letter forms";
	};
	lookup locl_SRB;
} ss07;

feature ss08 {
	featureNames {
		name "Bulgarian letter forms";
	};
	lookup locl_BGR;
} ss08;

feature salt {
	sub two by two.alt;
	sub three by three.alt;
	sub four by four.alt;
	sub six by six.alt;
	sub nine by nine.alt;
	sub D by D.alt;
	sub Eth by Eth.alt;
	sub Dcaron by Dcaron.alt;
	sub Dcroat by Dcroat.alt;
	sub Dhook by Dhook.alt;
	sub Ddotbelow by Ddotbelow.alt;
	sub Dmacronbelow by Dmacronbelow.alt;
	sub Eng by Eng.loclNSM;
	sub eng.sc by eng.sc.loclNSM;
	sub phi by phi1;
	sub phi1 by phi;
	sub zero by O;
	sub zero.sc by o;
	lookup locl_SRB;
	lookup locl_BGR;
} salt;

feature dlig {
	# typically these would be in 'clig', but this is not a typical font
	sub f f i by f_f_i;
	sub f f l by f_f_l;
	sub f f by f_f;
	sub f i by f_i;
	sub f l by f_l;
} dlig;

feature case {
	pos questiondown <0 200 0 0>;
	pos exclamdown <0 200 0 0>;
	pos uni2E18 <0 200 0 0 >;
} case;

